{
  "manifest_version": 3,
  "name": "BIPU Wallet — Don't Trust. Understand.",
  "version": "0.1.0",
  "description": "Teaching-first Quai wallet shell.",
  "permissions": ["storage", "sidePanel", "activeTab", "scripting"],
  "host_permissions": ["https://rpc.quai.network/*", "https://quaiscan.io/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open BIPU Wallet",
    "default_popup": "popup/popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options.html"
}
